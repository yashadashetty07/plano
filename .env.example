# Documentation only. Flutter does not load this file.
# Client configuration belongs in config/supabase.dev.json (ignored by Git),
# loaded with --dart-define-from-file=config/supabase.dev.json.
# Only these two public values belong in the Flutter app:
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only values: set in Supabase Edge Function secrets after deployment.
# Never put these in Flutter config, .env files used by Flutter, or Git:
# SUPABASE_SECRET_KEY (not required for the current user-scoped function)
# SUPABASE_JWKS_URL (not required; Supabase Auth getUser validates tokens)
# N8N_WEBHOOK_URL
# N8N_WEBHOOK_SECRET
# GROQ_API_KEY (n8n credential store)
