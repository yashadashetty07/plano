# PLANO Environment Configuration Template
# Copy this file to .env and provide your actual values.
# NEVER commit .env with real credentials into Git.

# Supabase Configuration (Client & Backend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Trusted Backend & n8n Automation Bridge
N8N_WEBHOOK_URL=https://your-n8n.example.com/webhook/plano-assistant
N8N_WEBHOOK_SECRET=replace_with_high_entropy_secret_at_least_32_chars

# Groq LLM Inference (Configured in n8n credentials)
GROQ_API_KEY=gsk_your_groq_api_key_here
